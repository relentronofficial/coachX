{
  "name": "@coachx/site-analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "Production-quality, boundary-respecting website crawler and analysis system for internetlifestylehub.com",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "analyze": "tsx src/index.ts",
    "inspect": "tsx src/index.ts --inspect-only",
    "crawl": "tsx src/index.ts --skip-analysis",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('storage',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "cheerio": "^1.0.0",
    "crawlee": "^3.12.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.5.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.48.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
