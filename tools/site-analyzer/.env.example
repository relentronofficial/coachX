# ---------------------------------------------------------------------------
# site-analyzer configuration
# Copy to `.env` and adjust. All values are optional; defaults shown below.
# ---------------------------------------------------------------------------

# Target site (host is derived from this; only same-host URLs are crawled)
TARGET_URL=https://internetlifestylehub.com

# Crawl scope
MAX_CONCURRENCY=2
MIN_CONCURRENCY=1
MAX_REQUEST_RETRIES=3
# Hard cap on pages crawled (0 = no cap, follow sitemap + discovery)
MAX_REQUESTS=0
# Max link-following depth from seeds (sitemap URLs are depth 0)
MAX_CRAWL_DEPTH=4

# Timeouts (seconds)
REQUEST_HANDLER_TIMEOUT_SECS=120
NAVIGATION_TIMEOUT_SECS=60

# Politeness — delay between requests (ms). Actual delay = MIN + random(0..JITTER)
MIN_DELAY_MS=1500
MAX_JITTER_MS=3000

# Identify the crawler honestly
USER_AGENT=Mozilla/5.0 (compatible; SiteAnalyzer/1.0; +site-inventory analysis; respects robots.txt)

# Behaviour toggles (true/false)
RESPECT_ROBOTS=true
TAKE_SCREENSHOTS=true
RUN_ACCESSIBILITY=true
CHECK_BROKEN_LINKS=true
HEADLESS=true

# Text excerpt cap (characters) — never store long copyrighted bodies
MAX_EXCERPT_CHARS=300

# Output directory (relative to tool root)
OUTPUT_DIR=output

# Log level: trace|debug|info|warn|error
LOG_LEVEL=info







