# Secret used to sign session JWTs. Set a long random value in production.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of admin email addresses (they get /admin access).
# If unset, dev fallback treats any address starting with "admin@" as admin.
# NOTE: setting this DISABLES that fallback — an explicit allow-list is never
# widened by the prefix rule. That is deliberate; see lib/auth/roles.ts.
ADMIN_EMAILS=admin@example.com

# ---------------------------------------------------------------------------
# E2E tests (optional — you do not need these to run the app)
#
# The Playwright suite signs in as one known admin rather than relying on the
# "admin@" fallback, so the admin specs pass identically whether or not a real
# .env.local exists. playwright.config.ts starts its own server on :3100 with
# ADMIN_EMAILS set to this address, so normally there is nothing to configure.
#
# Override only if the default collides with a real account in .data/users.json:
#   E2E_ADMIN_EMAIL=e2e-admin@coachx.test
#   E2E_ADMIN_PASSWORD=supersecret1
#
# Caveat: reuseExistingServer is on outside CI, so a server you started by hand
# on :3100 will be reused WITHOUT these settings and the admin specs will fail
# with an explanatory message. Stop it and let Playwright start its own.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Firebase (client SDK). Get these from the Firebase console:
# Project settings → General → Your apps → SDK setup and configuration.
# Put real values in `.env.local` (never commit that file).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloud Storage is a paid capability: a NEW project needs the Blaze plan (a
# payment method) to provision a Storage bucket. Auth + Firestore are free on
# the Spark plan. Set this to `false` to run fully free — file/photo uploads
# degrade gracefully and everything else works. Leave unset (or `true`) once
# Storage is enabled on the project.
NEXT_PUBLIC_FIREBASE_STORAGE_ENABLED=true
