{
  "name": "reference-site",
  "version": "0.1.0",
  "private": true,
  "description": "Original reference scaffold — coaching-community layout & design system with neutral placeholder content. Not affiliated with any real brand.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "firebase:verify": "node scripts/firebase-verify.mjs",
    "firebase:deploy-rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "test:e2e:firebase": "playwright test --project=firebase"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "jose": "^5.9.6",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
